# Example env file for Supabase secrets and local Edge Functions.
#
# Apply to Supabase:
#   supabase secrets set --env-file .env
#
# Local Edge Functions:
#   cp .env.example .env
#   supabase functions serve

# Redis (accelerator for idempotency + locks + geo cache)
# Prefer TLS (rediss://) when your Redis endpoint supports it.
# If your provider only exposes a plaintext port, use redis:// instead.
REDIS_URL=rediss://default:***@host:port

# Optional tuning (safe defaults used if unset)
REDIS_WEBHOOK_DONE_TTL_SECONDS=345600
REDIS_WEBHOOK_INFLIGHT_TTL_SECONDS=30
REDIS_ACCEPT_LOCK_TTL_MS=5000
REDIS_IDEMPOTENCY_TTL_SECONDS=600

